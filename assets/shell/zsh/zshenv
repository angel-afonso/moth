# Moth: installed as $ZDOTDIR/.zshenv. Restores the user's ZDOTDIR, sources
# their .zshenv and, in interactive shells, the integration. zsh rereads ZDOTDIR
# before each startup file, so .zprofile/.zshrc are the user's own.
if [[ -n "${MOTH_ORIG_ZDOTDIR+x}" ]]; then
  ZDOTDIR="$MOTH_ORIG_ZDOTDIR"
  unset MOTH_ORIG_ZDOTDIR
else
  unset ZDOTDIR
fi

{
  _moth_user_zshenv="${ZDOTDIR-$HOME}/.zshenv"
  [[ -r "$_moth_user_zshenv" ]] && builtin source "$_moth_user_zshenv"
} always {
  if [[ -o interactive && -r "$MOTH_SHELL_INTEGRATION" ]]; then
    builtin source "$MOTH_SHELL_INTEGRATION"
  fi
  unset _moth_user_zshenv
}
