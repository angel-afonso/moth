# terminalapp: se instala como $ZDOTDIR/.zshenv. Restaura el ZDOTDIR del usuario,
# carga su .zshenv y, en shells interactivas, la integración. zsh vuelve a leer
# ZDOTDIR antes de cada archivo de inicio, así que .zprofile/.zshrc son los del usuario.
if [[ -n "${TERMINALAPP_ORIG_ZDOTDIR+x}" ]]; then
  ZDOTDIR="$TERMINALAPP_ORIG_ZDOTDIR"
  unset TERMINALAPP_ORIG_ZDOTDIR
else
  unset ZDOTDIR
fi

{
  _tapp_user_zshenv="${ZDOTDIR-$HOME}/.zshenv"
  [[ -r "$_tapp_user_zshenv" ]] && builtin source "$_tapp_user_zshenv"
} always {
  if [[ -o interactive && -r "$TERMINALAPP_SHELL_INTEGRATION" ]]; then
    builtin source "$TERMINALAPP_SHELL_INTEGRATION"
  fi
  unset _tapp_user_zshenv
}
