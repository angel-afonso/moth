{
  "git": {
    "description": "Distributed version control",
    "subcommands": {
      "add": { "description": "Add changes to the staging area", "usage": "git add <paths>", "args": "changed", "flags": { "-A": "All changes, including deletions", "-p": "Interactively choose hunks", "-u": "Only already-tracked files" } },
      "branch": { "description": "List, create or delete branches", "usage": "git branch [-d] [<branch>]", "args": "branch", "flags": { "-d": "Delete a merged branch", "-D": "Force-delete a branch", "-m": "Rename the branch", "-a": "Include remote branches", "-v": "Show the last commit on each branch" } },
      "checkout": { "description": "Switch branches or restore working tree files", "usage": "git checkout [-b] <branch>", "args": "branch", "flags": { "-b": "Create and switch to the branch", "--track": "Track the remote branch", "--": "Restore files" } },
      "cherry-pick": { "description": "Apply the changes from existing commits", "usage": "git cherry-pick <commit>", "flags": { "--continue": "Continue after resolving conflicts", "--abort": "Cancel and return to the previous state", "-n": "Apply without committing" } },
      "clone": { "description": "Clone a repository into a new folder", "usage": "git clone <url> [<folder>]", "flags": { "--depth": "Clone only the last N commits", "-b": "Clone a specific branch" } },
      "commit": { "description": "Record staged changes", "usage": "git commit -m <message>", "flags": { "-m": "Commit message", "--amend": "Amend the last commit", "-a": "Include changes to tracked files", "--no-verify": "Skip hooks" } },
      "diff": { "description": "Show changes between commits, the index and the working tree", "usage": "git diff [<commit>] [-- <paths>]", "args": "changed", "flags": { "--staged": "Compare staged changes with the last commit", "--stat": "Only a per-file summary", "--name-only": "Only file names" } },
      "fetch": { "description": "Download objects and refs from another repository", "usage": "git fetch [<remote>]", "flags": { "--all": "From all remotes", "--prune": "Remove remote branches that no longer exist" } },
      "init": { "description": "Create an empty repository", "usage": "git init [<folder>]" },
      "log": { "description": "Show commit history", "usage": "git log [<range>]", "flags": { "--oneline": "One commit per line", "--graph": "Draw the branch graph", "-p": "Show the diff of each commit", "-n": "Limit the number of commits" } },
      "merge": { "description": "Merge another branch into the current one", "usage": "git merge <branch>", "args": "branch", "flags": { "--no-ff": "Always create a merge commit", "--squash": "Squash into a single uncommitted change", "--abort": "Abort a conflicted merge" } },
      "mv": { "description": "Move or rename a tracked file", "usage": "git mv <source> <destination>", "args": "path" },
      "pull": { "description": "Fetch changes and integrate them into the current branch", "usage": "git pull [--rebase] [<remote> <branch>]", "flags": { "--rebase": "Rebase instead of merging", "--ff-only": "Only fast-forward if there is no divergence" } },
      "push": { "description": "Send commits to the remote repository", "usage": "git push [<remote> <branch>]", "flags": { "-u": "Set the upstream branch", "--force-with-lease": "Force only if nobody else changed the branch", "--tags": "Push tags too" } },
      "rebase": { "description": "Reapply commits on top of another base", "usage": "git rebase [-i] <branch>", "args": "branch", "flags": { "-i": "Interactive: reorder, edit or squash commits", "--continue": "Continue after resolving conflicts", "--abort": "Abort the rebase" } },
      "remote": { "description": "Manage remote repositories", "usage": "git remote [-v]", "flags": { "-v": "Show URLs" },
        "subcommands": {
          "add": { "description": "Add a remote", "usage": "git remote add <name> <url>" },
          "remove": { "description": "Remove a remote", "usage": "git remote remove <name>" },
          "rename": { "description": "Rename a remote", "usage": "git remote rename <old> <new>" },
          "set-url": { "description": "Change a remote's URL", "usage": "git remote set-url <name> <url>" },
          "show": { "description": "Show a remote's branches and URLs", "usage": "git remote show <name>" },
          "prune": { "description": "Drop branches deleted on the remote", "usage": "git remote prune <name>" }
        } },
      "reset": { "description": "Move HEAD and optionally the index and working tree", "usage": "git reset [--soft | --hard] [<commit>]", "flags": { "--soft": "Keep changes staged", "--hard": "Discard all changes", "--mixed": "Keep changes unstaged" } },
      "restore": { "description": "Restore working tree files", "usage": "git restore [--staged] <paths>", "args": "changed", "flags": { "--staged": "Unstage from the staging area" } },
      "rm": { "description": "Remove files from the working tree and the index", "usage": "git rm <paths>", "args": "path", "flags": { "--cached": "Stop tracking without deleting the file" } },
      "show": { "description": "Show a commit or other object", "usage": "git show [<commit>]" },
      "stash": { "description": "Temporarily shelve changes", "usage": "git stash [push | pop | list]", "flags": { "-u": "Include untracked files" },
        "subcommands": {
          "push": { "description": "Shelve the changes", "usage": "git stash push [-u] [-m <message>]", "flags": { "-u": "Include untracked files", "-m": "Describe the stash", "--staged": "Only what's staged" } },
          "pop": { "description": "Apply the latest stash and drop it", "usage": "git stash pop [<stash>]" },
          "apply": { "description": "Apply a stash and keep it", "usage": "git stash apply [<stash>]" },
          "list": { "description": "List the stashes", "usage": "git stash list" },
          "show": { "description": "Show what a stash changes", "usage": "git stash show [-p] [<stash>]", "flags": { "-p": "As a patch" } },
          "drop": { "description": "Delete a stash", "usage": "git stash drop [<stash>]" },
          "clear": { "description": "Delete every stash", "usage": "git stash clear" }
        } },
      "status": { "description": "Show the working tree status", "usage": "git status [-s]", "flags": { "-s": "Short format", "-b": "Show the branch" } },
      "switch": { "description": "Switch branches", "usage": "git switch [-c] <branch>", "args": "branch", "flags": { "-c": "Create the branch and switch to it", "-": "Go back to the previous branch" } },
      "tag": { "description": "Create, list or delete tags", "usage": "git tag [-a] <name>", "flags": { "-a": "Annotated tag", "-d": "Delete a tag" } }
    }
  },
  "cargo": {
    "description": "Rust package manager and build tool",
    "subcommands": {
      "add": { "description": "Add a dependency to Cargo.toml", "usage": "cargo add <crate>", "flags": { "--dev": "As a dev dependency", "-F": "Enable features" } },
      "bench": { "description": "Run benchmarks", "usage": "cargo bench" },
      "build": { "description": "Compile the package", "usage": "cargo build [--release]", "flags": { "--release": "Build with optimizations", "-p": "Build a workspace package", "--all-features": "Enable all features", "--target": "Build for another target" } },
      "check": { "description": "Check that it compiles, without producing binaries", "usage": "cargo check", "flags": { "--all-targets": "Include tests, examples and benchmarks" } },
      "clean": { "description": "Remove the target folder", "usage": "cargo clean" },
      "clippy": { "description": "Run the Clippy linter", "usage": "cargo clippy [--fix]", "flags": { "--fix": "Apply automatic suggestions", "--all-targets": "Include tests and examples" } },
      "doc": { "description": "Build documentation", "usage": "cargo doc [--open]", "flags": { "--open": "Open in the browser" } },
      "fmt": { "description": "Format code with rustfmt", "usage": "cargo fmt", "flags": { "--check": "Only check, don't write" } },
      "init": { "description": "Create a package in the current folder", "usage": "cargo init" },
      "install": { "description": "Install a Rust binary", "usage": "cargo install <crate>" },
      "new": { "description": "Create a new package", "usage": "cargo new <name>", "flags": { "--lib": "Create a library" } },
      "run": { "description": "Build and run the binary", "usage": "cargo run [-- <args>]", "flags": { "--release": "With optimizations", "--bin": "Choose the binary", "--example": "Run an example" } },
      "test": { "description": "Run tests", "usage": "cargo test [<filter>]", "flags": { "--release": "With optimizations", "-p": "Test a workspace package", "--": "Pass arguments to the test runner" } },
      "update": { "description": "Update dependencies in Cargo.lock", "usage": "cargo update" }
    }
  },
  "npm": {
    "description": "Node.js package manager",
    "subcommands": {
      "install": { "description": "Install dependencies", "usage": "npm install [<package>]", "flags": { "-D": "As a dev dependency", "-g": "Install globally" } },
      "run": { "description": "Run a package.json script", "usage": "npm run <script>", "args": "script" },
      "test": { "description": "Run the test script", "usage": "npm test" },
      "start": { "description": "Run the start script", "usage": "npm start" },
      "uninstall": { "description": "Remove a dependency", "usage": "npm uninstall <package>" },
      "update": { "description": "Update dependencies", "usage": "npm update" },
      "outdated": { "description": "List outdated dependencies", "usage": "npm outdated" },
      "init": { "description": "Create a package.json", "usage": "npm init" },
      "publish": { "description": "Publish the package to the registry", "usage": "npm publish" }
    }
  },
  "pnpm": { "description": "Fast Node.js package manager", "subcommands": { "install": { "description": "Install dependencies", "usage": "pnpm install" }, "add": { "description": "Add a dependency", "usage": "pnpm add <package>", "flags": { "-D": "As a dev dependency" } }, "run": { "description": "Run a package.json script", "usage": "pnpm run <script>", "args": "script" }, "dev": { "description": "Run the dev script", "usage": "pnpm dev" }, "build": { "description": "Run the build script", "usage": "pnpm build" } } },
  "yarn": { "description": "Node.js package manager", "subcommands": { "install": { "description": "Install dependencies", "usage": "yarn install" }, "add": { "description": "Add a dependency", "usage": "yarn add <package>" }, "run": { "description": "Run a package.json script", "usage": "yarn run <script>", "args": "script" } } },
  "brew": {
    "description": "macOS package manager",
    "subcommands": {
      "install": { "description": "Install a formula or cask", "usage": "brew install <formula>", "flags": { "--cask": "Install an app (cask)" } },
      "uninstall": { "description": "Uninstall", "usage": "brew uninstall <formula>" },
      "upgrade": { "description": "Upgrade installed packages", "usage": "brew upgrade [<formula>]" },
      "update": { "description": "Update Homebrew and the formula list", "usage": "brew update" },
      "search": { "description": "Search formulae", "usage": "brew search <text>" },
      "list": { "description": "List installed packages", "usage": "brew list" },
      "info": { "description": "Show information about a formula", "usage": "brew info <formula>" },
      "services": { "description": "Manage background services", "usage": "brew services [start | stop | list] <formula>" },
      "doctor": { "description": "Diagnose installation problems", "usage": "brew doctor" },
      "cleanup": { "description": "Remove old versions and cache", "usage": "brew cleanup" }
    }
  },
  "docker": {
    "description": "Containers",
    "subcommands": {
      "build": { "description": "Build an image from a Dockerfile", "usage": "docker build -t <name> <folder>", "args": "dir", "flags": { "-t": "Image name and tag", "-f": "Dockerfile to use", "--no-cache": "Don't use the layer cache" } },
      "compose": { "description": "Manage multi-container applications", "usage": "docker compose [up | down | logs]", "flags": { "-f": "Compose file to use", "-p": "Project name" },
        "subcommands": {
          "up": { "description": "Create and start the services", "usage": "docker compose up [-d] [<service>]", "flags": { "-d": "In the background", "--build": "Build images first", "--force-recreate": "Recreate the containers" } },
          "down": { "description": "Stop and remove the services", "usage": "docker compose down [-v]", "flags": { "-v": "Remove the volumes too" } },
          "build": { "description": "Build the services' images", "usage": "docker compose build [<service>]", "flags": { "--no-cache": "Don't use the cache" } },
          "logs": { "description": "Show the services' output", "usage": "docker compose logs [-f] [<service>]", "flags": { "-f": "Follow the output", "--tail": "Only the last lines" } },
          "ps": { "description": "List the containers", "usage": "docker compose ps" },
          "exec": { "description": "Run a command in a running service", "usage": "docker compose exec <service> <command>" },
          "run": { "description": "Run a one-off command in a service", "usage": "docker compose run [--rm] <service> <command>", "flags": { "--rm": "Remove the container afterwards" } },
          "restart": { "description": "Restart the services", "usage": "docker compose restart [<service>]" },
          "stop": { "description": "Stop the services", "usage": "docker compose stop [<service>]" },
          "pull": { "description": "Pull the services' images", "usage": "docker compose pull" }
        } },
      "exec": { "description": "Run a command in a running container", "usage": "docker exec -it <container> <command>", "flags": { "-it": "Interactive with a terminal" } },
      "images": { "description": "List images", "usage": "docker images" },
      "logs": { "description": "Show a container's logs", "usage": "docker logs [-f] <container>", "flags": { "-f": "Follow the output" } },
      "ps": { "description": "List containers", "usage": "docker ps [-a]", "flags": { "-a": "Include stopped ones" } },
      "pull": { "description": "Download an image", "usage": "docker pull <image>" },
      "rm": { "description": "Remove containers", "usage": "docker rm <container>", "flags": { "-f": "Force, even if running" } },
      "rmi": { "description": "Remove images", "usage": "docker rmi <image>" },
      "run": { "description": "Create and start a container", "usage": "docker run [-it] [-p host:container] <image>", "flags": { "-it": "Interactive with a terminal", "-d": "In the background", "-p": "Publish a port", "--rm": "Remove when it exits", "-v": "Mount a volume" } },
      "stop": { "description": "Stop containers", "usage": "docker stop <container>" }
    }
  },
  "ssh": { "description": "Connect to a remote host", "usage": "ssh [user@]host", "args": "host", "flags": { "-p": "Port", "-i": "Private key file", "-J": "Jump through another host", "-L": "Forward a local port", "-A": "Forward the key agent" } },
  "cd": { "description": "Change folder", "usage": "cd <folder>", "args": "dir" },
  "ls": { "description": "List a folder's contents", "usage": "ls [-la] [<path>]", "args": "path", "flags": { "-l": "Long format", "-a": "Include hidden files", "-h": "Human-readable sizes", "-t": "Sort by modification time", "-G": "Colorized output" } },
  "mkdir": { "description": "Create folders", "usage": "mkdir [-p] <folder>", "args": "dir", "flags": { "-p": "Also create intermediate folders" } },
  "rm": { "description": "Remove files", "usage": "rm [-r] <paths>", "args": "path", "flags": { "-r": "Remove folders and their contents", "-f": "Don't prompt or warn", "-i": "Prompt before every removal" } },
  "cp": { "description": "Copy files", "usage": "cp [-r] <source> <destination>", "args": "path", "flags": { "-r": "Copy folders", "-p": "Preserve permissions and timestamps" } },
  "mv": { "description": "Move or rename", "usage": "mv <source> <destination>", "args": "path", "flags": { "-i": "Prompt before overwriting" } },
  "cat": { "description": "Print file contents", "usage": "cat <files>", "args": "path" },
  "less": { "description": "View a file one page at a time", "usage": "less <file>", "args": "path" },
  "head": { "description": "First lines of a file", "usage": "head [-n N] <file>", "args": "path", "flags": { "-n": "Number of lines" } },
  "tail": { "description": "Last lines of a file", "usage": "tail [-f] <file>", "args": "path", "flags": { "-f": "Follow the file as it grows", "-n": "Number of lines" } },
  "touch": { "description": "Create an empty file or update its timestamp", "usage": "touch <file>", "args": "path" },
  "grep": { "description": "Search for text in files", "usage": "grep [-rin] <pattern> <paths>", "args": "path", "flags": { "-r": "Recursive", "-i": "Case-insensitive", "-n": "Show line numbers", "-v": "Invert: lines that don't match" } },
  "find": { "description": "Find files", "usage": "find <folder> -name <pattern>", "args": "dir" },
  "chmod": { "description": "Change permissions", "usage": "chmod <mode> <paths>", "args": "path", "flags": { "-R": "Recursive" } },
  "tar": { "description": "Create or extract archives", "usage": "tar -czf <archive.tgz> <paths>", "args": "path", "flags": { "-c": "Create", "-x": "Extract", "-z": "Use gzip", "-f": "Archive file to use", "-v": "List files" } },
  "curl": { "description": "Transfer data from or to a URL", "usage": "curl [-sL] <url>", "flags": { "-s": "No progress bar", "-L": "Follow redirects", "-o": "Write to a file", "-X": "HTTP method", "-H": "Add a header", "-d": "Data to send" } },
  "open": { "description": "Open with the default macOS app", "usage": "open <path | url>", "args": "path", "flags": { "-a": "Choose the application", "-R": "Reveal in Finder" } },
  "code": { "description": "Open in Visual Studio Code", "usage": "code <path>", "args": "path" },
  "vim": { "description": "Text editor", "usage": "vim <file>", "args": "path" },
  "nvim": { "description": "Neovim, text editor", "usage": "nvim <file>", "args": "path" },
  "make": { "description": "Run Makefile targets", "usage": "make [<target>]", "args": "target", "flags": { "-j": "Run jobs in parallel", "-n": "Print the commands without running them", "-B": "Rebuild everything", "-C": "Run in another folder" } },
  "python3": { "description": "Python interpreter", "usage": "python3 <script.py>", "args": "path", "flags": { "-m": "Run a module", "-c": "Run code" } },
  "node": { "description": "Run JavaScript with Node.js", "usage": "node <script.js>", "args": "path" },
  "kill": { "description": "Send a signal to a process", "usage": "kill [-9] <pid>", "flags": { "-9": "Force kill" } },
  "ps": { "description": "List processes", "usage": "ps aux" },
  "top": { "description": "Live process monitor", "usage": "top" },
  "which": { "description": "Locate a command in PATH", "usage": "which <command>", "args": "command" },
  "man": { "description": "Manual page for a command", "usage": "man <command>", "args": "command" },
  "sudo": { "description": "Run as administrator", "usage": "sudo <command>", "args": "command" },
  "echo": { "description": "Print text", "usage": "echo <text>" },
  "export": { "description": "Set an environment variable", "usage": "export NAME=value" },
  "history": { "description": "Command history", "usage": "history" },
  "clear": { "description": "Clear the screen", "usage": "clear" },
  "exit": { "description": "Exit the shell", "usage": "exit [code]" },
  "claude": { "description": "Claude Code, coding assistant", "usage": "claude [<prompt>]", "flags": { "-c": "Continue the last conversation", "-p": "Respond without interactive mode", "--resume": "Resume a conversation" } }
}
