{
  "git": {
    "description": "Control de versiones distribuido",
    "subcommands": {
      "add": { "description": "Agregar cambios al área de preparación", "usage": "git add <rutas>", "args": "path", "flags": { "-A": "Todos los cambios, incluidos los borrados", "-p": "Elegir partes de forma interactiva", "-u": "Solo archivos ya seguidos" } },
      "branch": { "description": "Listar, crear o borrar ramas", "usage": "git branch [-d] [<rama>]", "args": "branch", "flags": { "-d": "Borrar una rama ya fusionada", "-D": "Borrar una rama a la fuerza", "-m": "Renombrar la rama", "-a": "Incluir ramas remotas", "-v": "Mostrar el último commit de cada rama" } },
      "checkout": { "description": "Cambiar de rama o restaurar archivos del árbol de trabajo", "usage": "git checkout [-b] <rama>", "args": "branch", "flags": { "-b": "Crear y cambiar a la rama", "--track": "Seguir la rama remota", "--": "Restaurar archivos" } },
      "cherry-pick": { "description": "Aplicar los cambios de commits existentes", "usage": "git cherry-pick <commit>", "flags": { "--continue": "Seguir después de resolver conflictos", "--abort": "Cancelar y volver al estado anterior", "-n": "Aplicar sin hacer commit" } },
      "clone": { "description": "Clonar un repositorio en una carpeta nueva", "usage": "git clone <url> [<carpeta>]", "flags": { "--depth": "Clonar solo los últimos N commits", "-b": "Clonar una rama concreta" } },
      "commit": { "description": "Registrar los cambios preparados", "usage": "git commit -m <mensaje>", "flags": { "-m": "Mensaje del commit", "--amend": "Modificar el último commit", "-a": "Incluir los cambios de archivos seguidos", "--no-verify": "Saltar los hooks" } },
      "diff": { "description": "Mostrar diferencias entre commits, el índice y el árbol", "usage": "git diff [<commit>] [-- <rutas>]", "args": "path", "flags": { "--staged": "Comparar lo preparado con el último commit", "--stat": "Solo un resumen por archivo", "--name-only": "Solo los nombres de archivo" } },
      "fetch": { "description": "Descargar objetos y referencias de otro repositorio", "usage": "git fetch [<remoto>]", "flags": { "--all": "De todos los remotos", "--prune": "Borrar ramas remotas que ya no existen" } },
      "init": { "description": "Crear un repositorio vacío", "usage": "git init [<carpeta>]" },
      "log": { "description": "Mostrar el historial de commits", "usage": "git log [<rango>]", "flags": { "--oneline": "Un commit por línea", "--graph": "Dibujar el grafo de ramas", "-p": "Mostrar el diff de cada commit", "-n": "Limitar la cantidad de commits" } },
      "merge": { "description": "Unir otra rama a la actual", "usage": "git merge <rama>", "args": "branch", "flags": { "--no-ff": "Crear siempre un commit de merge", "--squash": "Unir en un solo cambio sin commit", "--abort": "Cancelar un merge con conflictos" } },
      "mv": { "description": "Mover o renombrar un archivo seguido", "usage": "git mv <origen> <destino>", "args": "path" },
      "pull": { "description": "Traer cambios e integrarlos con la rama actual", "usage": "git pull [--rebase] [<remoto> <rama>]", "flags": { "--rebase": "Rebasar en lugar de fusionar", "--ff-only": "Solo avanzar si no hay divergencia" } },
      "push": { "description": "Enviar commits al repositorio remoto", "usage": "git push [<remoto> <rama>]", "flags": { "-u": "Configurar la rama remota a seguir", "--force-with-lease": "Forzar solo si nadie más cambió la rama", "--tags": "Enviar también las etiquetas" } },
      "rebase": { "description": "Reaplicar commits sobre otra base", "usage": "git rebase [-i] <rama>", "args": "branch", "flags": { "-i": "Interactivo: reordenar, editar o unir commits", "--continue": "Seguir después de resolver conflictos", "--abort": "Cancelar el rebase" } },
      "remote": { "description": "Administrar los repositorios remotos", "usage": "git remote [-v]", "flags": { "-v": "Mostrar las URLs" } },
      "reset": { "description": "Mover HEAD y, opcionalmente, el índice y el árbol", "usage": "git reset [--soft | --hard] [<commit>]", "flags": { "--soft": "Mantener los cambios preparados", "--hard": "Descartar todos los cambios", "--mixed": "Mantener los cambios sin preparar" } },
      "restore": { "description": "Restaurar archivos del árbol de trabajo", "usage": "git restore [--staged] <rutas>", "args": "path", "flags": { "--staged": "Quitar del área de preparación" } },
      "rm": { "description": "Borrar archivos del árbol y del índice", "usage": "git rm <rutas>", "args": "path", "flags": { "--cached": "Dejar de seguir sin borrar el archivo" } },
      "show": { "description": "Mostrar un commit u otro objeto", "usage": "git show [<commit>]" },
      "stash": { "description": "Guardar cambios temporalmente", "usage": "git stash [push | pop | list]", "flags": { "-u": "Incluir archivos sin seguimiento" } },
      "status": { "description": "Mostrar el estado del árbol de trabajo", "usage": "git status [-s]", "flags": { "-s": "Formato corto", "-b": "Mostrar la rama" } },
      "switch": { "description": "Cambiar de rama", "usage": "git switch [-c] <rama>", "args": "branch", "flags": { "-c": "Crear la rama y cambiar a ella", "-": "Volver a la rama anterior" } },
      "tag": { "description": "Crear, listar o borrar etiquetas", "usage": "git tag [-a] <nombre>", "flags": { "-a": "Etiqueta anotada", "-d": "Borrar una etiqueta" } }
    }
  },
  "cargo": {
    "description": "Gestor de paquetes y compilación de Rust",
    "subcommands": {
      "add": { "description": "Agregar una dependencia al Cargo.toml", "usage": "cargo add <crate>", "flags": { "--dev": "Como dependencia de desarrollo", "-F": "Activar features" } },
      "bench": { "description": "Correr los benchmarks", "usage": "cargo bench" },
      "build": { "description": "Compilar el paquete", "usage": "cargo build [--release]", "flags": { "--release": "Compilar con optimizaciones", "-p": "Compilar un paquete del workspace", "--all-features": "Activar todas las features", "--target": "Compilar para otra plataforma" } },
      "check": { "description": "Verificar que compila, sin generar binarios", "usage": "cargo check", "flags": { "--all-targets": "Incluir tests, ejemplos y benchmarks" } },
      "clean": { "description": "Borrar la carpeta target", "usage": "cargo clean" },
      "clippy": { "description": "Correr el linter Clippy", "usage": "cargo clippy [--fix]", "flags": { "--fix": "Aplicar las sugerencias automáticas", "--all-targets": "Incluir tests y ejemplos" } },
      "doc": { "description": "Generar la documentación", "usage": "cargo doc [--open]", "flags": { "--open": "Abrir en el navegador" } },
      "fmt": { "description": "Formatear el código con rustfmt", "usage": "cargo fmt", "flags": { "--check": "Solo verificar, sin escribir" } },
      "init": { "description": "Crear un paquete en la carpeta actual", "usage": "cargo init" },
      "install": { "description": "Instalar un binario de Rust", "usage": "cargo install <crate>" },
      "new": { "description": "Crear un paquete nuevo", "usage": "cargo new <nombre>", "flags": { "--lib": "Crear una biblioteca" } },
      "run": { "description": "Compilar y ejecutar el binario", "usage": "cargo run [-- <args>]", "flags": { "--release": "Con optimizaciones", "--bin": "Elegir el binario", "--example": "Correr un ejemplo" } },
      "test": { "description": "Correr los tests", "usage": "cargo test [<filtro>]", "flags": { "--release": "Con optimizaciones", "-p": "Tests de un paquete del workspace", "--": "Pasar argumentos al runner de tests" } },
      "update": { "description": "Actualizar las dependencias en Cargo.lock", "usage": "cargo update" }
    }
  },
  "npm": {
    "description": "Gestor de paquetes de Node.js",
    "subcommands": {
      "install": { "description": "Instalar dependencias", "usage": "npm install [<paquete>]", "flags": { "-D": "Como dependencia de desarrollo", "-g": "Instalar de forma global" } },
      "run": { "description": "Correr un script de package.json", "usage": "npm run <script>", "args": "script" },
      "test": { "description": "Correr el script de tests", "usage": "npm test" },
      "start": { "description": "Correr el script de inicio", "usage": "npm start" },
      "uninstall": { "description": "Quitar una dependencia", "usage": "npm uninstall <paquete>" },
      "update": { "description": "Actualizar dependencias", "usage": "npm update" },
      "outdated": { "description": "Ver dependencias desactualizadas", "usage": "npm outdated" },
      "init": { "description": "Crear un package.json", "usage": "npm init" },
      "publish": { "description": "Publicar el paquete en el registro", "usage": "npm publish" }
    }
  },
  "pnpm": { "description": "Gestor de paquetes de Node.js rápido", "subcommands": { "install": { "description": "Instalar dependencias", "usage": "pnpm install" }, "add": { "description": "Agregar una dependencia", "usage": "pnpm add <paquete>", "flags": { "-D": "Como dependencia de desarrollo" } }, "run": { "description": "Correr un script de package.json", "usage": "pnpm run <script>", "args": "script" }, "dev": { "description": "Correr el script dev", "usage": "pnpm dev" }, "build": { "description": "Correr el script build", "usage": "pnpm build" } } },
  "yarn": { "description": "Gestor de paquetes de Node.js", "subcommands": { "install": { "description": "Instalar dependencias", "usage": "yarn install" }, "add": { "description": "Agregar una dependencia", "usage": "yarn add <paquete>" }, "run": { "description": "Correr un script de package.json", "usage": "yarn run <script>", "args": "script" } } },
  "brew": {
    "description": "Gestor de paquetes de macOS",
    "subcommands": {
      "install": { "description": "Instalar una fórmula o cask", "usage": "brew install <fórmula>", "flags": { "--cask": "Instalar una app (cask)" } },
      "uninstall": { "description": "Desinstalar", "usage": "brew uninstall <fórmula>" },
      "upgrade": { "description": "Actualizar paquetes instalados", "usage": "brew upgrade [<fórmula>]" },
      "update": { "description": "Actualizar Homebrew y la lista de fórmulas", "usage": "brew update" },
      "search": { "description": "Buscar fórmulas", "usage": "brew search <texto>" },
      "list": { "description": "Listar lo instalado", "usage": "brew list" },
      "info": { "description": "Información de una fórmula", "usage": "brew info <fórmula>" },
      "services": { "description": "Administrar servicios en segundo plano", "usage": "brew services [start | stop | list] <fórmula>" },
      "doctor": { "description": "Diagnosticar problemas de la instalación", "usage": "brew doctor" },
      "cleanup": { "description": "Borrar versiones viejas y caché", "usage": "brew cleanup" }
    }
  },
  "docker": {
    "description": "Contenedores",
    "subcommands": {
      "build": { "description": "Construir una imagen desde un Dockerfile", "usage": "docker build -t <nombre> <carpeta>", "args": "dir", "flags": { "-t": "Nombre y etiqueta de la imagen", "-f": "Dockerfile a usar", "--no-cache": "Sin caché de capas" } },
      "compose": { "description": "Administrar aplicaciones de varios contenedores", "usage": "docker compose [up | down | logs]" },
      "exec": { "description": "Ejecutar un comando en un contenedor en marcha", "usage": "docker exec -it <contenedor> <comando>", "flags": { "-it": "Interactivo con terminal" } },
      "images": { "description": "Listar imágenes", "usage": "docker images" },
      "logs": { "description": "Ver los logs de un contenedor", "usage": "docker logs [-f] <contenedor>", "flags": { "-f": "Seguir la salida" } },
      "ps": { "description": "Listar contenedores", "usage": "docker ps [-a]", "flags": { "-a": "Incluir los detenidos" } },
      "pull": { "description": "Descargar una imagen", "usage": "docker pull <imagen>" },
      "rm": { "description": "Borrar contenedores", "usage": "docker rm <contenedor>", "flags": { "-f": "Forzar aunque esté en marcha" } },
      "rmi": { "description": "Borrar imágenes", "usage": "docker rmi <imagen>" },
      "run": { "description": "Crear y arrancar un contenedor", "usage": "docker run [-it] [-p host:contenedor] <imagen>", "flags": { "-it": "Interactivo con terminal", "-d": "En segundo plano", "-p": "Publicar un puerto", "--rm": "Borrar al terminar", "-v": "Montar un volumen" } },
      "stop": { "description": "Detener contenedores", "usage": "docker stop <contenedor>" }
    }
  },
  "ssh": { "description": "Conectarse a un host remoto", "usage": "ssh [usuario@]host", "args": "host", "flags": { "-p": "Puerto", "-i": "Archivo de clave privada", "-J": "Saltar por otro host", "-L": "Redirigir un puerto local", "-A": "Reenviar el agente de claves" } },
  "cd": { "description": "Cambiar de carpeta", "usage": "cd <carpeta>", "args": "dir" },
  "ls": { "description": "Listar el contenido de una carpeta", "usage": "ls [-la] [<ruta>]", "args": "path", "flags": { "-l": "Formato largo", "-a": "Incluir ocultos", "-h": "Tamaños legibles", "-t": "Ordenar por fecha", "-G": "Con colores" } },
  "mkdir": { "description": "Crear carpetas", "usage": "mkdir [-p] <carpeta>", "args": "dir", "flags": { "-p": "Crear también las carpetas intermedias" } },
  "rm": { "description": "Borrar archivos", "usage": "rm [-r] <rutas>", "args": "path", "flags": { "-r": "Borrar carpetas y su contenido", "-f": "Sin preguntar ni avisar", "-i": "Preguntar antes de cada borrado" } },
  "cp": { "description": "Copiar archivos", "usage": "cp [-r] <origen> <destino>", "args": "path", "flags": { "-r": "Copiar carpetas", "-p": "Mantener permisos y fechas" } },
  "mv": { "description": "Mover o renombrar", "usage": "mv <origen> <destino>", "args": "path", "flags": { "-i": "Preguntar antes de sobrescribir" } },
  "cat": { "description": "Mostrar el contenido de archivos", "usage": "cat <archivos>", "args": "path" },
  "less": { "description": "Ver un archivo página por página", "usage": "less <archivo>", "args": "path" },
  "head": { "description": "Primeras líneas de un archivo", "usage": "head [-n N] <archivo>", "args": "path", "flags": { "-n": "Cantidad de líneas" } },
  "tail": { "description": "Últimas líneas de un archivo", "usage": "tail [-f] <archivo>", "args": "path", "flags": { "-f": "Seguir el archivo a medida que crece", "-n": "Cantidad de líneas" } },
  "touch": { "description": "Crear un archivo vacío o actualizar su fecha", "usage": "touch <archivo>", "args": "path" },
  "grep": { "description": "Buscar texto en archivos", "usage": "grep [-rin] <patrón> <rutas>", "args": "path", "flags": { "-r": "Recursivo", "-i": "Sin distinguir mayúsculas", "-n": "Mostrar número de línea", "-v": "Invertir: líneas que no coinciden" } },
  "find": { "description": "Buscar archivos", "usage": "find <carpeta> -name <patrón>", "args": "dir" },
  "chmod": { "description": "Cambiar permisos", "usage": "chmod <modo> <rutas>", "args": "path", "flags": { "-R": "Recursivo" } },
  "tar": { "description": "Empaquetar o desempaquetar archivos", "usage": "tar -czf <archivo.tgz> <rutas>", "args": "path", "flags": { "-c": "Crear", "-x": "Extraer", "-z": "Con gzip", "-f": "Archivo a usar", "-v": "Mostrar los archivos" } },
  "curl": { "description": "Transferir datos desde o hacia una URL", "usage": "curl [-sL] <url>", "flags": { "-s": "Sin barra de progreso", "-L": "Seguir redirecciones", "-o": "Guardar en un archivo", "-X": "Método HTTP", "-H": "Agregar un header", "-d": "Datos a enviar" } },
  "open": { "description": "Abrir con la app predeterminada de macOS", "usage": "open <ruta | url>", "args": "path", "flags": { "-a": "Elegir la aplicación", "-R": "Mostrar en el Finder" } },
  "code": { "description": "Abrir en Visual Studio Code", "usage": "code <ruta>", "args": "path" },
  "vim": { "description": "Editor de texto", "usage": "vim <archivo>", "args": "path" },
  "nvim": { "description": "Neovim, editor de texto", "usage": "nvim <archivo>", "args": "path" },
  "make": { "description": "Ejecutar objetivos de un Makefile", "usage": "make [<objetivo>]" },
  "python3": { "description": "Intérprete de Python", "usage": "python3 <script.py>", "args": "path", "flags": { "-m": "Ejecutar un módulo", "-c": "Ejecutar código" } },
  "node": { "description": "Ejecutar JavaScript con Node.js", "usage": "node <script.js>", "args": "path" },
  "kill": { "description": "Enviar una señal a un proceso", "usage": "kill [-9] <pid>", "flags": { "-9": "Terminar a la fuerza" } },
  "ps": { "description": "Listar procesos", "usage": "ps aux" },
  "top": { "description": "Procesos en tiempo real", "usage": "top" },
  "which": { "description": "Ubicar un comando en el PATH", "usage": "which <comando>", "args": "command" },
  "man": { "description": "Manual de un comando", "usage": "man <comando>", "args": "command" },
  "sudo": { "description": "Ejecutar como administrador", "usage": "sudo <comando>", "args": "command" },
  "echo": { "description": "Imprimir texto", "usage": "echo <texto>" },
  "export": { "description": "Definir una variable de entorno", "usage": "export NOMBRE=valor" },
  "history": { "description": "Historial de comandos", "usage": "history" },
  "clear": { "description": "Limpiar la pantalla", "usage": "clear" },
  "exit": { "description": "Cerrar la shell", "usage": "exit [código]" },
  "claude": { "description": "Claude Code, asistente de programación", "usage": "claude [<pedido>]", "flags": { "-c": "Continuar la última conversación", "-p": "Responder sin modo interactivo", "--resume": "Retomar una conversación" } }
}
